# Copy to .env.online (never commit it) and fill in. Every value marked "secret" is a long random
# string: e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# docs/specs/2026-10-02-kataki-online.md §9.

# Where people reach the site (the TLS proxy's address), with no trailing slash
KATAKI_ORIGIN=http://localhost:8787

POSTGRES_PASSWORD=          # secret
BETTER_AUTH_SECRET=         # secret, at least 32 characters
KATAKI_GATEWAY_SECRET=      # secret, at least 32 bytes: signs the gateway's requests to the engine
KATAKI_GATEWAY_KEY=         # secret: the engine shows it to the gateway on /allow and /usage

# The service's model keys, one per provider in the catalogue: KATAKI_KEY_<PROVIDER NAME>
KATAKI_KEY_FAKE=x

# Optional
KATAKI_STARTER_CREDIT=0     # dollars given once to each new account
# RESEND_API_KEY=           # real email (docs/decisions.md); without it mail is printed in the log
# KATAKI_MAIL_FROM=Kataki <hello@your-domain>
# GITHUB_CLIENT_ID=         # sign in with GitHub; also GOOGLE_ and DISCORD_
# GITHUB_CLIENT_SECRET=
